include CITATION.cff
include LICENSE
include README.md
include environment.yml
include mkdocs.yml
include pyproject.toml
include pytest.ini
recursive-include configs *.toml
recursive-include docs *.md
recursive-include provenance *.json
recursive-include scripts *.py *.sh *.md
recursive-include tests *
prune archive
prune artifacts
prune build
prune dist
prune results
prune tmp
global-exclude *.py[cod]
global-exclude .DS_Store
